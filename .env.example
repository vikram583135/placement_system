# ==============================================================================
# Placement Management System - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!
# ==============================================================================

# -----------------------------------------------------------------------------
# Django Core Settings
# -----------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
SECRET_KEY=your-super-secret-key-generate-with-openssl-rand-base64-32

# Set to True for development, False for production
DEBUG=True

# Comma-separated list of allowed hosts (no spaces after commas)
ALLOWED_HOSTS=127.0.0.1,localhost,your-app.render.com,yourdomain.com

# -----------------------------------------------------------------------------
# Database Settings
# -----------------------------------------------------------------------------
# PostgreSQL connection string (provided by hosting platform)
# Format: postgresql://user:password@host:port/database
# For local SQLite: sqlite:///db.sqlite3
DATABASE_URL=postgresql://user:password@host:5432/placement_db

# -----------------------------------------------------------------------------
# Email Settings (for notifications, password reset, etc.)
# -----------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
# Use Gmail App Password (not your regular password!)
# Generate at: https://myaccount.google.com/apppasswords
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=Placement System <your_email@gmail.com>

# -----------------------------------------------------------------------------
# Cloudinary Settings (for media files: resumes, logos, documents)
# -----------------------------------------------------------------------------
# Sign up at: https://cloudinary.com (Free: 25GB storage, 25GB bandwidth)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# -----------------------------------------------------------------------------
# Optional: Sentry Error Tracking
# -----------------------------------------------------------------------------
# Sign up at: https://sentry.io (Free: 5K errors/month)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# -----------------------------------------------------------------------------
# Optional: Custom Domain
# -----------------------------------------------------------------------------
# CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com